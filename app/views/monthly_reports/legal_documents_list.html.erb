<%= turbo_frame_tag "remote_modal" do %>
  <%= render "layouts/remote_modal_content", title: "Documentos parafiscales para #{ @monthly_report.date_period.strftime("%B, %Y") }" do %>
    <%= turbo_frame_tag "legal_documents" do %>
      <%= render "legal_documents_list", monthly_report: @monthly_report %>
    <% end %>
    <%= turbo_frame_tag "add_legal_documents" %>
    <%= link_to add_legal_documents_monthly_report_path(@monthly_report), class: "btn btn-primary mt-2", data: { turbo_frame: "add_legal_documents" } do %>
      <i class="bi bi-file-earmark-arrow-up-fill"></i> Subir documentos parafiscales
    <% end %>
  <% end %>
<% end %>