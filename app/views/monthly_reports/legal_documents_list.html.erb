<%= turbo_frame_tag "remote_modal" do %>
  <%= render "layouts/remote_modal_content", title: "Documentos parafiscales para #{ @monthly_report.date_period.strftime("%B, %Y") }" do %>
    <div class="card card-body">
      <% if @legal_documents_list.empty? %>
        <p>No hay documentos parafiscales adjuntos.</p>
      <% else %>
        <ul class="list-group list-group-flush">
          <% @legal_documents_list.each do |legal_document| %>
            <li class="list-group-item">
              <%= link_to legal_document.file.filename, source_file.url, target: "_blank" %>
              <%= link_to " - Eliminar soporte", "#", data: { turbo: false } if current_user == @monthly_report.user %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <%= turbo_frame_tag "add_legal_documents" %>
    <%= link_to "#", class: "btn btn-primary mt-2", data: { turbo_frame: "add_legal_documents" } do %>
      <i class="bi bi-file-earmark-arrow-up-fill"></i> Subir documentos parafiscales
    <% end %>
  <% end %>
<% end %>