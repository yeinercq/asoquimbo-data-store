<% status_types = { "created" => "text-bg-primary", "reported" => "text-bg-secondary", "revised" => "text-bg-warning", "approved" => "text-bg-success" } %>
<span class="badge rounded-pill <%= status_types[monthly_report.status] || "text-bg-primary" %>"><%= "#{t("activerecord.attributes.monthly_report.status/#{monthly_report.status}")}" %></span>