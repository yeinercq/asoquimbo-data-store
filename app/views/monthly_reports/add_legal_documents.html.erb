<%= turbo_frame_tag "add_legal_documents" do %>
  <%= simple_form_for @monthly_report, url: save_legal_documents_monthly_report_path(@monthly_report), html: { class: "form card card-body shadow mt-2" } do |f| %>
    <%= form_error_notification(@monthly_report) %>

    <div class="mb-3">
      <% @monthly_report.legal_documents.each do |legal_document| %>
        <%= hidden_field :monthly_report, :legal_documents, multiple: true, value: legal_document.identifier %>
      <% end %>
      <%= t("common.form.file_formats_label") %>
      <%= f.file_field :legal_documents, multiple: true, accept: 'pdf/doc/docx/xls/xlsx/csv/jpg/jpeg/png', class: 'form-control' %>
    </div>

    <div class="col-12 d-flex justify-content-end gap-2">
      <%= link_to t("common.cancel"), legal_documents_list_monthly_report_path(@monthly_report), class: "btn btn-secondary" %>
      <%= f.submit t("common.accept"), class: "btn btn-warning"%>
    </div>
  <% end %>
<% end %>