<meta charset="utf-8" />
<%= wicked_pdf_stylesheet_link_tag "pdf" %>

<h1>INFORME MENSUAL</h1>
<h2>Convenio 103 de 2026 &mdash; <%= date_period_short_format(@monthly_report.date_period) %></h2>

<div class="section-title">
  <h3>
    Datos del informe
  </h3>
</div>
<table>
  <tr>
    <td style="font-weight: bold;">Periodo reportado</td>
    <td><%= date_period_short_format(@monthly_report.date_period) if @monthly_report.date_period %></td>
  </tr>
  <tr>
    <td style="font-weight: bold;">Fecha de presentación</td>
    <td><%= l(@monthly_report.created_at.to_date, format: :long) %></td>
  </tr>
  <tr>
    <td style="font-weight: bold;">Componente</td>
    <td><%= @custom_select_list.custom_option_name(@monthly_report.component) %></td>
  </tr>
  <tr>
    <td style="width: 180px; font-weight: bold;">Reportado por</td>
    <td><%= @monthly_report.user&.name %></td>
  </tr>
  <tr>
    <td style="width: 180px; font-weight: bold;">Revisado por</td>
    <td>
      <%= @monthly_report.transitioned_by("revised") %> - <%= @monthly_report.transitioned_date_by("revised").to_time.strftime("%d/%m/%Y %H:%M") %>
    </td>
  </tr>
  <tr>
    <td style="width: 180px; font-weight: bold;">Aprobado por</td>
    <td>
      <%= @monthly_report.transitioned_by("approved") %> - <%= @monthly_report.transitioned_date_by("approved").to_time.strftime("%d/%m/%Y %H:%M") %>
    </td>
  </tr>
</table>

<div class="section-title">
  <h1>Actividades</h1>
</div>
<% if @monthly_report.activities.any? %>
  <table>
    <thead>
      <tr>
        <th style="width: 15%;">Proyecto</th>
        <th style="width: 20%;">Objetivo asociado</th>
        <th style="width: 15%;">Actividad</th>
        <th style="width: 30%;">Descripción</th>
        <th style="width: 10%;">Fecha inicio</th>
        <th style="width: 10%;">Fecha fin</th>
      </tr>
    </thead>
    <tbody>
      <% @monthly_report.activities.each do |activity| %>
        <tr>
          <td><%= option_name(activity.project) %></td>
          <td><%= option_name(activity.associated_objective) %></td>
          <td><%= option_name(activity.activity_name) %></td>
          <td><%= activity.description %></td>
          <td><%= l(activity.start_date, format: :short) if activity.start_date %></td>
          <td><%= l(activity.end_date, format: :short) if activity.end_date %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p><em>Sin actividades registradas</em></p>
<% end %> 

<div class="signatures">
  <div class="signature-block">
    <p class="signature-label">Quien elabora:</p>
    <div class="signature-line">&nbsp;</div>
    <p class="signature-name"><%= @monthly_report.user&.name %></p>
  </div>

  <div class="signature-block">
    <p class="signature-label">Quien revisa:</p>
    <div class="signature-line">&nbsp;</div>
    <p class="signature-name"><%= @monthly_report.transitioned_by("revised") %></p>
    <% revised_date = @monthly_report.transitioned_date_by("revised") %>
    <% if revised_date != "-" %>
      <p class="signature-date"><%= revised_date.to_time.strftime("%d/%m/%Y") %></p>
    <% end %>
  </div>

  <div class="signature-block">
    <p class="signature-label">Quien aprueba:</p>
    <div class="signature-line">&nbsp;</div>
    <p class="signature-name"><%= @monthly_report.transitioned_by("approved") %></p>
    <% approved_date = @monthly_report.transitioned_date_by("approved") %>
    <% if approved_date != "-" %>
      <p class="signature-date"><%= approved_date.to_time.strftime("%d/%m/%Y") %></p>
    <% end %>
  </div>
</div>

<div class="footer">
  Generado el <%= l(Time.current, format: :long) %> &mdash; Asoquimbo
</div>
