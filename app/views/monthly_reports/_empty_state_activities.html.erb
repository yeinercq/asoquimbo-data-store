<div class="empty-state empty-state--only-child">
  <p class="empty-state__text">
    Aún no hay actividades creadas para este reporte mensual.
  </p>
  <% if can? :create, @monthly_report %>
    <%= link_to new_monthly_report_activity_path(@monthly_report), class: "btn btn-primary", data: { turbo_frame: dom_id(Activity.new) } do %>
      <i class="bi bi-plus-circle-fill"></i> Nueva actividad
    <% end %>
  <% end %>
</div>
