<div class="header mt-3">
  <div class="d-flex align-items-center gap-2">
    <h1>INFORME MENSUAL <%= date_period_short_format(@monthly_report.date_period) %></h1>
    <div>
      <%= tag.div id: "monthly_report_status" do %>
        <%= render "monthly_reports/status", monthly_report: @monthly_report %>
      <% end %>
    </div>
  </div>
  <div class="row justify-content-end">
    <figure class="col-12 col-md-6 text-end">
      <blockquote class="blockquote">
        <p><%= @monthly_report.goal.presence || "No tiene logro del mes" %></p>
      </blockquote>
      <figcaption class="blockquote-footer">
        Logro del mes
      </figcaption>
    </figure>
</div>
<div>
  <div class="row align-items-center">
    <div class="col-12 col-md-4">
      <%= link_to monthly_reports_path, class: "btn btn-outline-primary", data: { turbo_frame: "_top" } do %>
        <i class="bi bi-arrow-left"></i> Atrás
      <% end %>
      <% if can?(:create, @monthly_report) && @monthly_report.status == "created" %>
        <%= link_to new_monthly_report_activity_path(@monthly_report), class: "btn btn-primary", data: { turbo_frame: dom_id(Activity.new) } do %>
          <i class="bi bi-plus-circle-fill"></i> Nueva actividad
        <% end %>
      <% end %>
    </div>
    <%= tag.div class: "col-12 col-md-4" do %>
      <div id="monthly_report_trigger_status">
        <%= render "monthly_reports/trigger_status", monthly_report: @monthly_report %>
      </div>
    <% end %>
    <div class="d-inline-flex justify-content-end gap-1 col-12 col-md-4">
      <% if can? :legal_documents_list, @monthly_report %>
        <%= link_to "Documentos parafiscales", legal_documents_list_monthly_report_path(@monthly_report), class: "btn btn-primary", data: { turbo_frame: "remote_modal" } %>
      <% end %>
      <% if can?( :export_pdf, @monthly_report) && @monthly_report.status == "approved" %>
        <%= link_to export_pdf_monthly_report_path(@monthly_report, format: :pdf), class: "btn btn-outline-danger", target: "_blank" do %>
          <i class="bi bi-file-earmark-pdf"></i> PDF
        <% end %>
      <% end %>
      <button class="btn btn-success" type="button" data-bs-toggle="collapse" data-bs-target="#monthly_report_history_collapse" aria-expanded="false" aria-controls="monthly_report_history_collapse">Ver historial</button>
    </div>
  </div>
</div>
<div class="row">
  <div class="col my-1">
    <div class="collapse multi-collapse" id="monthly_report_history_collapse">
      <div class="card card-body" id="monthly_report_history">
        <%= render "monthly_reports/history", monthly_report: @monthly_report %>
      </div>
    </div>
  </div>
</div>
<div class="overflow-x-scroll">
  <div class="d-flex border rounded px-3 align-items-center bg-success text-white" style="min-width: 1200px;">
    <div class="col-2"><small>PROYECTO</small></div>
    <div class="col-3"><small>OBJETIVO ASOCIADO</small></div>
    <div class="col-2"><small>ACTIVIADAD</small></div>
    <div class="col-2"><small>FECHA INICIO</small></div>
    <div class="col-2"><small>FECHA FIN</small></div>
    <div class="col-1"><small>ESTADO</small></div>
  </div>
  <%= turbo_frame_tag Activity.new %>
  <%= turbo_frame_tag "activities" do %>
    <%= render "empty_state_activities" %>
    <%= render @monthly_report.activities.ordered %>
  <% end %>
</div>
