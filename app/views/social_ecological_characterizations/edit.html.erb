<%= turbo_frame_tag "remote_modal" do %>
  <div class="modal-header">
    <h4 class="modal-title">Editar Caracterización Social y Ecológica</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
  </div>
  <div class="modal-body">
    <%= render "form", social_ecological_characterization: @social_ecological_characterization %>
  </div>
<% end %>