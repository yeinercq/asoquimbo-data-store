<%= turbo_frame_tag data_base_record do %>
  <div class="card shadow mt-2">
    <div class="card-body">
      <div class="row align-items-center">
        <div class="col-12 col-md-3">
          <strong>Título:</strong> <%= data_base_record.document_title %>
        </div>

        <div class="col-12 col-md-3">
          <strong>Autores:</strong> <%= data_base_record.authors %>
        </div>

        <div class="col-12 col-md-1">
          <strong>Año:</strong> <%= data_base_record.year %>
        </div>

        <div class="col-12 col-md-3">
          <strong>Institución/Entidad:</strong> <%= data_base_record.institutions_entities %>
        </div>

        <div class="col-12 col-md-2 justify-content-end d-flex gap-2">
          <%= link_to data_base_record_path(data_base_record), data: { turbo_frame: "remote_modal" } do %>
            <div class="btn btn-info">
              <i class="bi bi-eye"></i>
            </div>
          <% end %>
          <%= link_to edit_data_base_record_path(data_base_record), data: { turbo_frame: "remote_modal" } do %>
            <div class="btn btn-secondary">
              <i class="bi bi-pencil"></i>
            </div>
          <% end %>
          <%= link_to data_base_record_path(data_base_record), data: { turbo_method: :delete , turbo_confirm: t("common.form.confirm_delete")} do %>
            <div class="btn btn-danger">
              <i class="bi bi-trash"></i>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>