<!-- remove placeholders -->
<%= turbo_stream.remove("records_placeholder") %>

<% if @data_base_records.empty? %>
  <!-- append empty_state template to the #data_base_records turbo_frame -->
  <%= turbo_stream.append("data_base_records") do %>
    <%= render "empty_state" %>
  <% end %>
<% else %>
  <!-- append @data_base_records to the #data_base_records turbo_frame -->
  <%= turbo_stream.append("data_base_records") do %>
    <%= render @data_base_records %>
  <% end %>
<% end %>

<!-- update the pagination turbo_frame with the current pagination offset -->
<% if @pagy.next.present? %>
  <%= turbo_stream.replace "pagy" do %>
    <%= turbo_frame_tag "pagy", src: data_base_records_path(request.query_parameters.merge(page: @pagy.next, format: :turbo_stream)), loading: "lazy" do %>
      <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <%= turbo_stream.remove "pagy" %>
<% end %>
