
<div class="header mt-3">
  <h1>REGISTROS DE BASE DE DATOS</h1>
  <div class="d-flex justify-content-start gap-2">
    <%= link_to new_data_base_record_path, class: "btn btn-primary", data: { turbo_frame: "remote_modal" } do %>
      <i class="bi bi-plus-circle-fill"></i> Nuevo registro
    <% end %>
    <%= link_to import_form_data_base_records_path, class: "btn btn-secondary", data: { turbo_frame: "import_form" } do %>
      <i class="bi bi-database-fill-up"></i> Importar registros
    <% end %>
    <%= link_to import_tags_form_data_base_records_path, class: "btn btn-secondary", data: { turbo_frame: "import_form" } do %>
      <i class="bi bi-database-fill-up"></i> Importar etiquetas
    <% end %>
    <%= link_to "#", class: "btn btn-secondary", data: { turbo: false } do %>
      <i class="bi bi-database-fill-down"></i> Exportar registros
    <% end %>
  </div>
</div>

<% if custom_select_list_and_custom_options_for_select_exists?(DataBaseRecord) %>
  <div class="filters mt-2">
    <%# Seach form %>
    <div class="row">
      <%= form_with( url: data_base_records_path(format: :turbo_stream), method: :get, class: "d-block d-md-flex flex-row flex-wrap gap-2 justify-content-end align-items-center" ) do |form| %>
        <%= form.hidden_field :from_search_form, value: "true" %>
        <div class="col mb-2">
          <%= form.select :record_type, DataBaseRecord.record_types.map { |key, value| [key, key] }, { prompt: "Tipo de registro" }, { class: 'form-select' } %>
        </div>

        <div class="col mb-2">
          <%= form.select :document_family, custom_options_for_select(:document_family), { prompt: "Familia documental" }, { class: 'form-select' } %>
        </div>

        <div class="col mb-2">
          <%= form.select :geographic_area, custom_options_for_select(:geographic_area), { prompt: "Área geográfica" }, { class: 'form-select' } %>
        </div>

        <div class="col mb-2">
          <%= form.select :access_level, custom_options_for_select(:access_level), { prompt: "Nivel de acceso" }, { class: 'form-select' } %>
        </div>

        <div class="col mb-2">
          <%= form.select :territorial_scale, custom_options_for_select(:territorial_scale), { prompt: "Escala territorial" }, { class: 'form-select' } %>
        </div>

        <div class="col mb-2">
          <%= form.number_field :year, value: params[:year], min: 1900, step: 1, placeholder: "Año", class: 'form-control' %>
        </div>

        <div class="col-12 mb-2">
          <%= form.text_field :tags, placeholder: "Filtrar por etiquetas", class: "form-control", data: { controller: "tags", tags_whitelist_value: @whitelist_tags } %>
        </div>

        <div class="col-auto mb-2">
          <%= form.submit "Buscar", class: "btn btn-primary" %>
          <%= form.submit "Exportar", class: "btn btn-secondary", formaction: data_base_records_path(format: :csv) %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%= turbo_frame_tag "import_form" %>
<%= turbo_frame_tag "data_base_records", src: data_base_records_path(request.query_parameters.merge(format: :turbo_stream)), loading: "lazy" do %>
  <div id="records_placeholder">
    <% 3.times do %>
      <%= render "data_base_record_placeholder" %>
    <% end %>
  </div>
<% end %>
<%= turbo_frame_tag "pagy" do %>
  <div class="d-flex justify-content-center">
    <div class="spinner-border" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
  </div>
<% end%>