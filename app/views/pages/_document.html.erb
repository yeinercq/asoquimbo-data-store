<div class="card border shadow rounded-4 h-100 mb-3">
  <div class="card-body d-flex flex-column">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <span class="text-muted small">
        <i class="bi bi-calendar3 me-1"></i><%= document.year %>
      </span>
      <% if document.source_file? %>
        <span class="text-success fs-5" title="Documento adjunto">
          <i class="bi bi-file-earmark-pdf"></i>
        </span>
      <% else %>
        <span class="text-primary fs-5" title="Enlace a la fuente original">
          <i class="bi bi-box-arrow-up-right"></i>
        </span>
      <% end %>
    </div>

    <h5 class="card-title fw-semibold mb-2"><%= document.document_title %></h5>

    <p class="text-muted small mb-1">
      <i class="bi bi-people me-1"></i><%= document.authors %>
    </p>

    <hr>
    <% if document.apa_citation.present? %>
      <div class="d-flex gap-2 align-items-start mb-3">
        <p class="text-muted small mb-0">
          <i class="bi bi-quote me-1"></i><%= document.apa_citation %>
        </p>
        <button type="button"
                class="btn btn-sm btn-outline-secondary rounded-pill flex-shrink-0"
                title="Copiar cita APA"
                data-controller="copy"
                data-copy-text-value="<%= document.apa_citation %>"
                data-action="click->copy#copy">
          <i class="bi bi-clipboard"> Copiar cita APA</i>
        </button>
      </div>
    <% end %>

    <div class="mt-auto d-flex justify-content-end">
      <%= link_to document.document_link, target: "_blank", rel: "noopener", class: "btn btn-outline-success btn-sm rounded-pill px-3" do %>
        <i class="bi bi-box-arrow-up-right me-1"></i>Abrir documento
      <% end %>
    </div>
  </div>
</div>
