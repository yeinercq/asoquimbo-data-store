<div class="card border shadow rounded-4 h-100 mb-3">
  <div class="card-body d-flex flex-column">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <span class="text-muted small">
        <i class="bi bi-calendar3 me-1"></i><%= document.year %>
      </span>
      <span class="text-success fs-5" title="Documento disponible">
        <i class="bi bi-file-earmark-pdf"></i>
      </span>
    </div>

    <h5 class="card-title fw-semibold mb-2"><%= document.document_title %></h5>

    <p class="text-muted small mb-3">
      <i class="bi bi-people me-1"></i><%= document.authors %>
    </p>

    <div class="mt-auto d-flex justify-content-end">
      <%= link_to document.source_file_url, target: "_blank", rel: "noopener", class: "btn btn-outline-success btn-sm rounded-pill px-3" do %>
        <i class="bi bi-box-arrow-up-right me-1"></i>Abrir documento
      <% end %>
    </div>
  </div>
</div>
