<nav class="navbar navbar-light bg-white sticky-top shadow border-bottom py-2">
  <div class="container-fluid">
    <div class="w-100">

      <% if custom_select_list_and_custom_options_for_select_exists?(DataBaseRecord) %>
        <div class="filters">
          <%# Seach form %>
          <div class="row">
            <%= form_with( url: pages_data_bases_index_path, method: :get, data: { turbo_frame: 'data_base_records'}, class: "d-block d-md-flex flex-row flex-wrap gap-2 justify-content-end align-items-center" ) do |form| %>
              <div class="col-auto">
                Filtrar:
              </div>

              <div class="col-auto mb-2">
                <%= form.select :record_type, DataBaseRecord.record_types.map { |key, value| [key, key] }, { prompt: "Tipo de registro" }, { class: 'form-select' } %>
              </div>

              <div class="col-auto mb-2">
                <%= form.select :document_family, custom_options_for_select(:document_family), { prompt: "Familia documental" }, { class: 'form-select' } %>
              </div>

              <div class="col-auto mb-2">
                <%= form.select :geographic_area, custom_options_for_select(:geographic_area), { prompt: "Área geográfica" }, { class: 'form-select' } %>
              </div>

              <div class="col-auto mb-2">
                <%= form.select :access_level, custom_options_for_select(:access_level), { prompt: "Nivel de acceso" }, { class: 'form-select' } %>
              </div>

              <div class="col-auto mb-2">
                <%= form.select :territorial_scale, custom_options_for_select(:territorial_scale), { prompt: "Escala territorial" }, { class: 'form-select' } %>
              </div>

              <div class="col-auto mb-2">
                <%= form.number_field :year, value: params[:year], min: 1900, step: 1, placeholder: "Año", class: 'form-control' %>
              </div>

              <div class="col-auto mb-2">
                <%= form.text_field :tag, placeholder: "Filtrar por etiqueta", class: "form-control" %>
              </div>

              <div class="col-auto mb-2">
                <%= form.submit "Buscar", class: "btn btn-primary" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</nav>

<%= turbo_frame_tag "data_base_records" do %>
  <%= render "empty_state" %>
  <% if @data_base_records.any? %>
    <div class="row row-cols-1 g-4 mt-2">
      <%= render partial: "index_data_base_record", collection: @data_base_records, as: :data_base_record %>
    </div>
  <% end %>
<% end %>

<!-- Offcanvas -->

<div 
  class="offcanvas offcanvas-end" 
  style="--bs-offcanvas-width: min(760px, 100vw);"
  tabindex="-1" 
  id="offcanvasExample" 
  aria-labelledby="offcanvasExampleLabel"
  data-controller="offcanvas" 
  data-action="turbo:frame-load->offcanvas#open turbo:submit-end->offcanvas#close"
>
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="offcanvasExampleLabel">Detalle del registro</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <%= turbo_frame_tag "data_base_record_detail" %>
  </div>
</div>