<section id="landing" class="d-flex align-items-start justify-content-center" style="min-height: 100vh;">
  <div class="container" style="padding-top: 178px;">
    <div class="row justify-content-start">
      <div class="col-12 col-md-10">
        <h1 class="display-3 fw-bold mb-3 text-start text-light">Plan de monitoreo socioecológico, comunitario y participativo en El Quimbo</h1>
        <h3 class="mb-3 text-start text-light">
          Convenio No. 103 de 2026 – Fondo para la Vida y la Biodiversidad / ASOQUIMBO Consulta aquí la Curaduría de información secundaria
        </h3>
        
        <div class="btn-group mb-2 gap-2 bg-dark bg-opacity-75 py-2  col-12 col-md-auto px-4" role="group" aria-label="Basic radio toggle button group">
          <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked>
          <label class="btn btn-outline-success rounded-4" for="btnradio1" style="width: 130px;">Todo</label>

          <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off">
          <label class="btn btn-outline-success rounded-4" for="btnradio2" style="width: 130px;">Metodologías</label>

          <input type="radio" class="btn-check" name="btnradio" id="btnradio3" autocomplete="off">
          <label class="btn btn-outline-success rounded-4" for="btnradio3" style="width: 130px;">Antecedentes</label>
        </div>

      </div>
      <div class="col-12 col-md-10">
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-2 text-start">
          <div class="input-group">
            <input type="search" class="form-control form-control-lg border-end-0 bg-white search-placeholder" id="search-home-page" placeholder="Buscar en la base de datos. Ej.: pesca artesanal, calidad del agua, caudal, biodiversidad" aria-label="Buscar">
            <span class="input-group-text bg-white border-start-0 text-dark">
              <i class="bi bi-search"></i>
            </span>
          </div>
        </div>
      </div>

      <p class="col-12 col-md-10 text-start text-light">
        Consulta metodologías, estudios, monitoreos y antecedentes sociales y econógicos relacionados con el área de influencia del proyecto hdroelectríco El Quimbo 
      </p>
    </div>
  </div>
</section>

<section id="about" class="d-flex align-items-center justify-content-center bg-light" style="min-height: 100vh;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12">

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
          <div class="col">
            <div class="card shadow border-0 rounded-4 h-100" style="background-color: #DFF3E4;">
              <div class="card-body d-flex align-items-center justify-content-center gap-4 p-4">
                <div class="d-flex align-items-center gap-3 text-center text-md-start">
                  <i class="bi bi-clipboard-check flex-shrink-0 text-success" style="font-size: 3rem;"></i>
                  <div>
                    <div class="d-flex align-items-baseline gap-2 justify-content-center justify-content-md-start">
                      <span class="display-5 fw-bold"
                        data-controller="animated-number"
                        data-animated-number-lazy-value=""
                        data-animated-number-start-value="0"
                        data-animated-number-end-value="21"
                        data-animated-number-duration-value="1500"
                      >
                        0
                      </span>
                      <span class="h5 fw-semibold mb-0">Metodologías</span>
                    </div>
                    <p class="mb-0 text-muted">Protocolos y enfoques de monitoreo</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col">
            <div class="card shadow border-0 rounded-4 h-100" style="background-color: #DFE9F7;">
              <div class="card-body d-flex align-items-center justify-content-center gap-4 p-4">
                <div class="d-flex align-items-center gap-3 text-center text-md-start">
                  <i class="bi bi-people-fill flex-shrink-0 text-primary" style="font-size: 3rem;"></i>
                  <div>
                    <div class="d-flex align-items-baseline gap-2 justify-content-center justify-content-md-start">
                      <span class="display-5 fw-bold"
                        data-controller="animated-number"
                        data-animated-number-lazy-value=""
                        data-animated-number-start-value="0"
                        data-animated-number-end-value="176"
                        data-animated-number-duration-value="1700"
                      >
                        0
                      </span>
                      <span class="h5 fw-semibold mb-0">Antecedentes</span>
                    </div>
                    <p class="mb-0 text-muted">Estudios y registros socio territoriales</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col">
            <div class="card shadow border-0 rounded-4 h-100" style="background-color: #DDF2ED;">
              <div class="card-body d-flex align-items-center justify-content-center gap-4 p-4">
                <div class="d-flex align-items-center gap-3 text-center text-md-start">
                  <i class="bi bi-tree-fill flex-shrink-0 text-info" style="font-size: 3rem;"></i>
                  <div>
                    <div class="d-flex align-items-baseline gap-2 justify-content-center justify-content-md-start">
                      <span class="display-5 fw-bold"
                        data-controller="animated-number"
                        data-animated-number-lazy-value=""
                        data-animated-number-start-value="0"
                        data-animated-number-end-value="67"
                        data-animated-number-duration-value="1900"
                      >
                        0
                      </span>
                      <span class="h5 fw-semibold mb-0">Registros</span>
                    </div>
                    <p class="mb-0 text-muted">Datos de biodiversidad y ecosistemas</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col">
            <div class="card shadow border-0 rounded-4 h-100" style="background-color: #FBE9D9;">
              <div class="card-body d-flex align-items-center justify-content-center gap-4 p-4">
                <div class="d-flex align-items-center gap-3 text-center text-md-start">
                  <i class="bi bi-geo-alt-fill flex-shrink-0 text-warning" style="font-size: 3rem;"></i>
                  <div>
                    <div class="d-flex align-items-baseline gap-2 justify-content-center justify-content-md-start">
                      <span class="display-5 fw-bold"
                        data-controller="animated-number"
                        data-animated-number-lazy-value=""
                        data-animated-number-start-value="0"
                        data-animated-number-end-value="10"
                        data-animated-number-duration-value="2100"
                      >
                        0
                      </span>
                      <span class="h5 fw-semibold mb-0">Municipios</span>
                    </div>
                    <p class="mb-0 text-muted">En el área de influencia del proyecto</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
        </div>
      </div>
    </div>

    <div class="row mt-5">
      <div class="row">
        <div class="col-4">
          <%= image_tag('landing-page-background.jpg', alt: "Logotipo", class: "img-fluid rounded shadow") %>
        </div>
        <div class="col-8">
          <h2>Sobre el plan de monitoreo</h2>
          <p class="lh-lg">
            El plan de monitoreo socioecológico, comunitario y participativo en El Quimbo es una iniciativa para cosolidar, curar y poner a diposición pública, información 
            relevante sobre los componentes sociales y ecológicos del área de influencia del proyecto hidroeléctico El Quimbo, promoviendo el acceso abierto al conocimiento
            y el fortalecimiento de la participación cuidadana.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>