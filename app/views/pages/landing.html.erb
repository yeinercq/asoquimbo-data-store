<section id="sobre-el-proyecto" class="d-flex align-items-center justify-content-center" style="min-height: 100vh;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12">
        <h1 class="display-4 fw-bold mb-3 text-start text-light">Plan de monitoreo socioecológico comunitario y participativo en el Quimbo</h1>
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-3 text-start">
          <div class="input-group">
            <input type="search" class="form-control form-control-lg border-end-0 bg-white" placeholder="Buscar en la base de datos" aria-label="Buscar">
            <span class="input-group-text bg-white border-start-0 text-dark">
              <i class="bi bi-search"></i>
            </span>
          </div>
        </div>

        <div class="btn-group btn-group" role="group" aria-label="Basic checkbox toggle button group">
          <button type="button" class="btn btn-dark opacity-75" data-bs-toggle="popover" data-bs-content="Funcionalidad disponible próximamente">
            Metodologías para el monitoreo socioecológico
          </button>
          <button type="button" class="btn btn-dark opacity-75" data-bs-toggle="popover" data-bs-content="Funcionalidad disponible próximamente">
            Monitoreos previos y antecedentes socioecológicos
          </button>
        </div>      
      </div>
    </div>
  </div>
</section>

<section id="patrocinadores" class="d-flex align-items-center justify-content-center bg-light" style="min-height: 100vh;">
  <div class="container-fluid">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-8 text-center">
        <h2 class="fw-bold mb-4">Nuestros patrocinadores</h2>

        <div class="d-flex flex-wrap justify-content-center align-items-center gap-5">
          <%= image_tag "logo-asoquimbo-horizontal.png", alt: "Asoquimbo", class: "img-fluid", style: "max-height: 150px;" %>
          <%= image_tag "logo-FVB-horizontal.png", alt: "FVB", class: "img-fluid", style: "max-height: 150px;" %>
        </div>

        <!-- <p class="text-muted mt-4">
          <small>
            ¿Le interesa patrocinar este proyecto?
            <%= mail_to "contacto@asoquimbo.com", "Contáctenos", class: "text-decoration-none" %>
          </small>
        </p> -->
      </div>
    </div>
  </div>
</section>

<%= link_to new_user_session_path, class: "position-fixed bottom-0 end-0 m-4 btn btn-warning rounded-pill shadow-lg px-4 py-2" do %>
  <i class="bi bi-box-arrow-in-right me-2"></i>¿Ya eres parte del proyecto? Inicia sesión aquí
<% end %>
