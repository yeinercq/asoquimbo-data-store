<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Asoquimbo Data Store" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body class="<%= 'landing-page' if current_page?(root_path) %>" style="<%= "--landing-bg-image: url('#{asset_path('landing-page-background.jpg')}')" if current_page?(root_path) %>" data-bs-spy="scroll" data-bs-target="#pillNav" data-bs-smooth-scroll="true" tabindex="0">
    <!-- Navbar -->
    <% if current_page?(root_path) %>
      <%= render "layouts/nav_pill" %>
    <% elsif !current_page?('/pages/data_bases_index') %>
      <%= render "layouts/navbar"%>
    <% end %>

    <!-- Flash notifications -->
    <div aria-live="polite" aria-atomic="true" class="position-relative">
      <div id="flash_notifications" class="toast-container position-fixed top-0 end-0 p-3">
        <!-- Flash notifications will be injected here -->
        <%= render "layouts/flash_notifications" %>
      </div>
    </div>

    <div class="<%= current_page?(root_path) ? "min-vh-100" : "container-fluid min-vh-100 mb-2" %>">
      <%= yield %>
    </div>

    <%= render "layouts/footer" if current_page?(root_path) %>

    <%# remote_modal %>
    <div 
      class="modal modal-xl fade"
      id="remote_modal_container" 
      data-bs-backdrop="static" 
      data-bs-keyboard="false" 
      tabindex="-1" 
      aria-labelledby="remote_modal" 
      aria-hidden="true" 
      data-controller="remote-modal" 
      data-action="turbo:frame-load->remote-modal#open turbo:submit-end->remote-modal#close"
    >
      <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
        <%= turbo_frame_tag "remote_modal" %>
      </div>
    </div>
  </body>
</html>
